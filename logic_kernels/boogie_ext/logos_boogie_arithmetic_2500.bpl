procedure ArithmeticObligations_012()
{
  assert (-328+-398)--398 == -328;
  assert (-291--345)+-345 == -291;
  assert (-254+-292)+379 == -254+(-292+379);
  assert -217*(-239+450) == -217*-239+-217*450;

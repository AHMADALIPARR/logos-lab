// LOGOS arithmetic verification obligations
// Pure Boogie IVL. No axioms, assume statements, or external functions.
// Every assertion is an arithmetic verification obligation.

procedure Add(a:int,b:int) returns (r:int)
  ensures r == a+b;
{
  r := a+b;
  assert r-a == b;
  assert r-b == a;
}

procedure Subtract(a:int,b:int) returns (r:int)
  ensures r == a-b;
{
  r := a-b;
  assert r+b == a;
  assert a-r == b;
}

procedure Negate(a:int) returns (r:int)
  ensures r == -a;
{
  r := -a;
  assert r+a == 0;
  assert -r == a;
}

procedure AbsInt(a:int) returns (r:int)
  ensures r >= 0;
  ensures r == a || r == -a;
{
  if (a >= 0) { r := a; }
  else { r := -a; }
  assert r >= 0;
}

procedure MinInt(a:int,b:int) returns (r:int)
  ensures r <= a && r <= b;
  ensures r == a || r == b;
{
  if (a <= b) { r := a; }
  else { r := b; }
}

procedure MaxInt(a:int,b:int) returns (r:int)
  ensures r >= a && r >= b;
  ensures r == a || r == b;
{
  if (a >= b) { r := a; }
  else { r := b; }
}

procedure ClampInt(x:int,lo:int,hi:int) returns (r:int)
  requires lo <= hi;
  ensures lo <= r && r <= hi;
  ensures (x < lo ==> r == lo);
  ensures (x > hi ==> r == hi);
  ensures (lo <= x && x <= hi ==> r == x);
{
  if (x < lo) { r := lo; }
  else if (x > hi) { r := hi; }
  else { r := x; }
}

procedure EuclideanDivision(a:int,b:int) returns (q:int,r:int)
  requires b > 0;
  ensures a == b*q+r;
  ensures 0 <= r && r < b;
{
  q := a div b;
  r := a mod b;
  assert a == b*q+r;
  assert 0 <= r && r < b;
}

procedure PositiveMod(a:int,m:int) returns (r:int)
  requires m > 0;
  ensures 0 <= r && r < m;
  ensures (a-r) mod m == 0;
{
  r := a mod m;
  assert a == m*(a div m)+r;
}

procedure AverageFloorNonnegative(a:int,b:int) returns (r:int)
  requires 0 <= a && 0 <= b;
  ensures 2*r <= a+b;
  ensures a+b < 2*(r+1);
{
  r := (a+b) div 2;
}

procedure Triangular(n:int) returns (r:int)
  requires n >= 0;
  ensures 2*r == n*(n+1);
{
  var i:int;
  i := 0;
  r := 0;
  while (i < n)
    invariant 0 <= i && i <= n;
    invariant 2*r == i*(i+1);
  {
    i := i+1;
    r := r+i;
  }
}

procedure SumSquares(n:int) returns (r:int)
  requires n >= 0;
  ensures 6*r == n*(n+1)*(2*n+1);
{
  var i:int;
  i := 0;
  r := 0;
  while (i < n)
    invariant 0 <= i && i <= n;
    invariant 6*r == i*(i+1)*(2*i+1);
  {
    i := i+1;
    r := r+i*i;
  }
}

procedure SumOdd(n:int) returns (r:int)
  requires n >= 0;
  ensures r == n*n;
{
  var i:int;
  i := 0;
  r := 0;
  while (i < n)
    invariant 0 <= i && i <= n;
    invariant r == i*i;
  {
    r := r+2*i+1;
    i := i+1;
  }
}

procedure MultiplyByAddition(a:int,n:int) returns (r:int)
  requires n >= 0;
  ensures r == a*n;
{
  var i:int;
  i := 0;
  r := 0;
  while (i < n)
    invariant 0 <= i && i <= n;
    invariant r == a*i;
  {
    r := r+a;
    i := i+1;
  }
}

procedure PowerOfTwo(n:int) returns (r:int)
  requires n >= 0;
  ensures r >= 1;
{
  var i:int;
  i := 0;
  r := 1;
  while (i < n)
    invariant 0 <= i && i <= n;
    invariant r >= 1;
  {
    r := r*2;
    i := i+1;
  }
}

procedure QuotientRemainderPositive(a:int,b:int) returns (q:int,r:int)
  requires a >= 0 && b > 0;
  ensures a == q*b+r;
  ensures 0 <= r && r < b;
  ensures q >= 0;
{
  q := 0;
  r := a;
  while (r >= b)
    invariant q >= 0 && r >= 0;
    invariant a == q*b+r;
  {
    r := r-b;
    q := q+1;
  }
}

procedure IntegerDistance(a:int,b:int) returns (d:int)
  ensures d >= 0;
  ensures d == a-b || d == b-a;
{
  if (a >= b) { d := a-b; }
  else { d := b-a; }
}

procedure SaturatingAddNonnegative(a:int,b:int,cap:int) returns (r:int)
  requires a >= 0 && b >= 0 && cap >= 0;
  ensures r >= 0 && r <= cap;
  ensures (a+b <= cap ==> r == a+b);
  ensures (a+b > cap ==> r == cap);
{
  if (a+b <= cap) { r := a+b; }
  else { r := cap; }
}

procedure CeilingDivisionNonnegative(a:int,b:int) returns (q:int)
  requires a >= 0 && b > 0;
  ensures (q-1)*b < a || a == 0;
  ensures a <= q*b;
  ensures q >= 0;
{
  q := (a+b-1) div b;
}

procedure GcdEuclid(a:int,b:int) returns (g:int)
  requires a >= 0 && b >= 0 && a+b > 0;
  ensures g > 0;
  ensures a mod g == 0;
  ensures b mod g == 0;
{
  var x:int;
  var y:int;
  var t:int;
  x := a;
  y := b;
  while (y != 0)
    invariant x >= 0 && y >= 0;
    invariant x+y > 0;
    invariant (forall d:int :: d > 0 && a mod d == 0 && b mod d == 0 ==> x mod d == 0 && y mod d == 0);
    invariant (forall d:int :: d > 0 && x mod d == 0 && y mod d == 0 ==> a mod d == 0 && b mod d == 0);
  {
    t := x mod y;
    x := y;
    y := t;
  }
  g := x;
}


% emitted by emit.pl

%% append/3
append/3:
  switch_on_term append/3#v append/3#1 append/3#2 fail
append/3#v:
  try append/3#1
  trust append/3#2
append/3#1:
  get_constant [] X1
  get_variable X4 X2
  get_value X4 X3
  proceed
append/3#2:
  get_list X1
  unify_variable X4
  unify_variable X5
  get_variable X6 X2
  get_list X3
  unify_value X4
  unify_variable X7
  put_value X5 X1
  put_value X6 X2
  put_value X7 X3
  execute append/3

% ?- append([a, b], [c], X).
query
  name X Y1
  allocate 1
  put_list X4
  set_constant b
  set_constant []
  put_list X1
  set_constant a
  set_value X4
  put_list X2
  set_constant c
  set_constant []
  put_variable Y1 X3
  call append/3
  halt

% ?- append(X, Y, [a, b, c]).
query
  name X Y1
  name Y Y2
  allocate 2
  put_variable Y1 X1
  put_variable Y2 X2
  put_list X5
  set_constant c
  set_constant []
  put_list X4
  set_constant b
  set_value X5
  put_list X3
  set_constant a
  set_value X4
  call append/3
  halt

% ?- append(X, [c], [a, b, c]).
query
  name X Y1
  allocate 1
  put_variable Y1 X1
  put_list X2
  set_constant c
  set_constant []
  put_list X5
  set_constant c
  set_constant []
  put_list X4
  set_constant b
  set_value X5
  put_list X3
  set_constant a
  set_value X4
  call append/3
  halt

% ?- append([a|T], [z], [a, b, z]).
query
  name T Y1
  allocate 1
  put_list X1
  set_constant a
  set_variable Y1
  put_list X2
  set_constant z
  set_constant []
  put_list X5
  set_constant z
  set_constant []
  put_list X4
  set_constant b
  set_value X5
  put_list X3
  set_constant a
  set_value X4
  call append/3
  halt

% emitted by emit.pl

%% vowel/1
vowel/1:
  switch_on_term vowel/1#v vowel/1#v fail fail
vowel/1#v:
  try vowel/1#1
  retry vowel/1#2
  trust vowel/1#3
vowel/1#1:
  get_constant a X1
  proceed
vowel/1#2:
  get_constant e X1
  proceed
vowel/1#3:
  get_constant i X1
  proceed

%% classify/2
classify/2:
  try_me_else classify/2#2
  allocate 1
  get_level Y1
  get_variable X3 X1
  get_constant vowel X2
  put_value X3 X1
  call vowel/1
  cut Y1
  deallocate
  proceed
classify/2#2:
  trust_me
  get_constant consonant X2
  proceed

%% first/2
first/2:
  switch_on_term first/2#v first/2#2 first/2#1 fail
first/2#v:
  try first/2#1
  trust first/2#2
first/2#1:
  get_list X1
  unify_variable X3
  unify_void 1
  get_value X3 X2
  neck_cut
  proceed
first/2#2:
  get_constant [] X1
  get_constant none X2
  proceed

%% kind/2
kind/2:
  get_variable X3 X1
  get_variable X4 X2
  put_value X3 X1
  put_value X4 X2
  execute '$ite1'/2

%% '$ite2'/2
'$ite2'/2:
  try_me_else '$ite2'/2#2
  allocate 2
  get_level Y2
  get_variable X3 X1
  get_variable Y1 X2
  put_value X3 X1
  call atom/1
  cut Y2
  put_unsafe_value Y1 X1
  put_constant atom X2
  deallocate
  execute '='/2
'$ite2'/2#2:
  trust_me
  get_variable X3 X2
  put_value X3 X1
  put_constant other X2
  execute '='/2

%% '$ite1'/2
'$ite1'/2:
  try_me_else '$ite1'/2#2
  allocate 2
  get_level Y2
  get_variable X3 X1
  get_variable Y1 X2
  put_value X3 X1
  call var/1
  cut Y2
  put_unsafe_value Y1 X1
  put_constant unbound X2
  deallocate
  execute '='/2
'$ite1'/2#2:
  trust_me
  get_variable X3 X1
  get_variable X4 X2
  put_value X3 X1
  put_value X4 X2
  execute '$ite2'/2

%% different/2
different/2:
  get_variable X3 X1
  get_variable X4 X2
  put_value X3 X1
  put_value X4 X2
  execute '$not3'/2

%% '$not3'/2
'$not3'/2:
  try_me_else '$not3'/2#2
  allocate 1
  get_level Y1
  get_variable X3 X1
  get_variable X4 X2
  put_value X3 X1
  put_value X4 X2
  call '='/2
  cut Y1
  fail
  deallocate
  proceed
'$not3'/2#2:
  trust_me
  proceed

%% colour/1
colour/1:
  switch_on_term colour/1#v colour/1#v fail fail
colour/1#v:
  try colour/1#1
  retry colour/1#2
  trust colour/1#3
colour/1#1:
  get_constant red X1
  proceed
colour/1#2:
  get_constant green X1
  proceed
colour/1#3:
  get_constant blue X1
  proceed

%% not_red/1
not_red/1:
  allocate 1
  get_variable Y1 X1
  put_value Y1 X1
  call colour/1
  put_unsafe_value Y1 X1
  put_constant red X2
  deallocate
  execute '\\=='/2

%% either/1
either/1:
  get_variable X2 X1
  put_value X2 X1
  execute '$or4'/1

%% '$or4'/1
'$or4'/1:
  try_me_else '$or4'/1#2
  get_variable X3 X1
  put_value X3 X1
  put_constant left X2
  execute '='/2
'$or4'/1#2:
  trust_me
  get_variable X3 X1
  put_value X3 X1
  put_constant right X2
  execute '='/2

%% pick/2
pick/2:
  allocate 3
  get_level Y3
  get_variable Y1 X1
  get_variable Y2 X2
  put_value Y1 X1
  put_value Y3 X2
  call '$or5'/2
  put_unsafe_value Y2 X1
  put_unsafe_value Y1 X2
  deallocate
  execute '='/2

%% '$or5'/2
'$or5'/2:
  try_me_else '$or5'/2#2
  allocate 2
  get_variable Y1 X1
  get_variable Y2 X2
  put_value Y1 X1
  call colour/1
  put_value Y1 X1
  put_constant red X2
  call '\\='/2
  cut Y2
  deallocate
  proceed
'$or5'/2#2:
  trust_me
  get_variable X3 X1
  put_value X3 X1
  put_constant none X2
  execute '='/2

% ?- classify(e, K).
query
  name K Y1
  allocate 1
  put_constant e X1
  put_variable Y1 X2
  call classify/2
  halt

% ?- classify(z, K).
query
  name K Y1
  allocate 1
  put_constant z X1
  put_variable Y1 X2
  call classify/2
  halt

% ?- first([a, b, c], X).
query
  name X Y1
  allocate 1
  put_list X4
  set_constant c
  set_constant []
  put_list X3
  set_constant b
  set_value X4
  put_list X1
  set_constant a
  set_value X3
  put_variable Y1 X2
  call first/2
  halt

% ?- first([], X).
query
  name X Y1
  allocate 1
  put_constant [] X1
  put_variable Y1 X2
  call first/2
  halt

% ?- kind(foo, K).
query
  name K Y1
  allocate 1
  put_constant foo X1
  put_variable Y1 X2
  call kind/2
  halt

% ?- kind(_590, K).
query
  name K Y1
  allocate 1
  put_variable X1 X1
  put_variable Y1 X2
  call kind/2
  halt

% ?- kind(f(x), K).
query
  name K Y1
  allocate 1
  put_structure f/1 X1
  set_constant x
  put_variable Y1 X2
  call kind/2
  halt

% ?- different(a, b).
query
  allocate 0
  put_constant a X1
  put_constant b X2
  call different/2
  halt

% ?- different(a, a).
query
  allocate 0
  put_constant a X1
  put_constant a X2
  call different/2
  halt

% ?- not_red(C).
query
  name C Y1
  allocate 1
  put_variable Y1 X1
  call not_red/1
  halt

% ?- either(X).
query
  name X Y1
  allocate 1
  put_variable Y1 X1
  call either/1
  halt

% ?- pick(X, Y).
query
  name X Y1
  name Y Y2
  allocate 2
  put_variable Y1 X1
  put_variable Y2 X2
  call pick/2
  halt

%% '$ite6'/2
'$ite6'/2:
  try_me_else '$ite6'/2#2
  allocate 3
  get_level Y3
  get_variable Y1 X1
  get_variable Y2 X2
  put_value Y1 X1
  call colour/1
  put_value Y1 X1
  put_constant blue X2
  call '=='/2
  cut Y3
  put_unsafe_value Y2 X1
  put_constant found X2
  deallocate
  execute '='/2
'$ite6'/2#2:
  trust_me
  get_variable X3 X2
  put_value X3 X1
  put_constant missing X2
  execute '='/2

% ?- colour(X), X==blue->Y=found;Y=missing.
query
  name X Y1
  name Y Y2
  allocate 2
  put_variable Y1 X1
  put_variable Y2 X2
  call '$ite6'/2
  halt

%% '$not7'/0
'$not7'/0:
  try_me_else '$not7'/0#2
  allocate 1
  get_level Y1
  put_constant purple X1
  call colour/1
  cut Y1
  fail
  deallocate
  proceed
'$not7'/0#2:
  trust_me
  proceed

% ?- \+colour(purple).
query
  allocate 0
  call '$not7'/0
  halt

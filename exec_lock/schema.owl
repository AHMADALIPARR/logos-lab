<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-SnapKitty-Opaque-1.0 -->
<!-- Copyright Ahmad Ali Parr -->
<!-- Stochastic Autonomous Compute Mesh: rigid OWL 2 DL taxonomy for the execution lock. -->
<rdf:RDF
    xmlns="https://snapkitty.example/scm#"
    xml:base="https://snapkitty.example/scm"
    xmlns:scm="https://snapkitty.example/scm#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="https://snapkitty.example/scm"/>

  <!-- Classes -->
  <owl:Class rdf:about="https://snapkitty.example/scm#Agent"/>
  <owl:Class rdf:about="https://snapkitty.example/scm#Capability"/>
  <owl:Class rdf:about="https://snapkitty.example/scm#Signal"/>
  <owl:Class rdf:about="https://snapkitty.example/scm#TrustDeed"/>
  <owl:Class rdf:about="https://snapkitty.example/scm#WORM_Hash"/>

  <owl:Class rdf:about="https://snapkitty.example/scm#ProvenSignal">
    <rdfs:subClassOf rdf:resource="https://snapkitty.example/scm#Signal"/>
    <owl:disjointWith rdf:resource="https://snapkitty.example/scm#Noise"/>
  </owl:Class>

  <owl:Class rdf:about="https://snapkitty.example/scm#Noise">
    <rdfs:subClassOf rdf:resource="https://snapkitty.example/scm#Signal"/>
  </owl:Class>

  <owl:Class rdf:about="https://snapkitty.example/scm#AgentExecution">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://snapkitty.example/scm#hasWORMHash"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://snapkitty.example/scm#WORM_Hash"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- Pairwise disjointness of the rigid top-level classes -->
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://snapkitty.example/scm#Agent"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#Capability"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#Signal"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#TrustDeed"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#WORM_Hash"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#AgentExecution"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <!-- Object properties -->
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#hasWORMHash">
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#AgentExecution"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#WORM_Hash"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#executedBy">
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#AgentExecution"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Agent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#deedHolder">
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#TrustDeed"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Agent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#deedCapability">
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#TrustDeed"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Capability"/>
  </owl:ObjectProperty>

  <!-- OWL anchor: agents -->
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#agent_alpha">
    <rdf:type rdf:resource="https://snapkitty.example/scm#Agent"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#agent_beta">
    <rdf:type rdf:resource="https://snapkitty.example/scm#Agent"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#agent_gamma">
    <rdf:type rdf:resource="https://snapkitty.example/scm#Agent"/>
  </owl:NamedIndividual>

  <!-- OWL anchor: capabilities -->
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#cap_seal_recursion">
    <rdf:type rdf:resource="https://snapkitty.example/scm#Capability"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#cap_read_mesh">
    <rdf:type rdf:resource="https://snapkitty.example/scm#Capability"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#cap_spawn_worker">
    <rdf:type rdf:resource="https://snapkitty.example/scm#Capability"/>
  </owl:NamedIndividual>

  <!-- OWL anchor: proven signals -->
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#sig_heartbeat">
    <rdf:type rdf:resource="https://snapkitty.example/scm#ProvenSignal"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#sig_quorum_ack">
    <rdf:type rdf:resource="https://snapkitty.example/scm#ProvenSignal"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#sig_merkle_root">
    <rdf:type rdf:resource="https://snapkitty.example/scm#ProvenSignal"/>
  </owl:NamedIndividual>

  <!-- OWL anchor: a known noise signal -->
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#sig_static_burst">
    <rdf:type rdf:resource="https://snapkitty.example/scm#Noise"/>
  </owl:NamedIndividual>

  <!-- OWL anchor: a trust deed -->
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#deed_alpha_seal">
    <rdf:type rdf:resource="https://snapkitty.example/scm#TrustDeed"/>
    <deedHolder rdf:resource="https://snapkitty.example/scm#agent_alpha"/>
    <deedCapability rdf:resource="https://snapkitty.example/scm#cap_seal_recursion"/>
  </owl:NamedIndividual>

  <!-- OWL anchor: one sealed execution carrying exactly one WORM hash -->
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#hash_0">
    <rdf:type rdf:resource="https://snapkitty.example/scm#WORM_Hash"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#exec_0">
    <rdf:type rdf:resource="https://snapkitty.example/scm#AgentExecution"/>
    <executedBy rdf:resource="https://snapkitty.example/scm#agent_alpha"/>
    <hasWORMHash rdf:resource="https://snapkitty.example/scm#hash_0"/>
  </owl:NamedIndividual>

  <owl:AllDifferent>
    <owl:distinctMembers rdf:parseType="Collection">
      <rdf:Description rdf:about="https://snapkitty.example/scm#agent_alpha"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#agent_beta"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#agent_gamma"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#cap_seal_recursion"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#cap_read_mesh"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#cap_spawn_worker"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#sig_heartbeat"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#sig_quorum_ack"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#sig_merkle_root"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#sig_static_burst"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#deed_alpha_seal"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#hash_0"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#exec_0"/>
    </owl:distinctMembers>
  </owl:AllDifferent>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       Etymology: the axioms and rules of logos_etymology/src/axioms.pl
       Every edge, morpheme and sense carries evidence or it does not exist.
       ═══════════════════════════════════════════════════════════════════════════ -->

  <!-- Classes -->
  <owl:Class rdf:about="https://snapkitty.example/scm#Lexeme"/>
  <owl:Class rdf:about="https://snapkitty.example/scm#OrthographicSlice"/>
  <owl:Class rdf:about="https://snapkitty.example/scm#DerivationEdge"/>
  <owl:Class rdf:about="https://snapkitty.example/scm#Morpheme"/>
  <owl:Class rdf:about="https://snapkitty.example/scm#Sense"/>
  <owl:Class rdf:about="https://snapkitty.example/scm#Source"/>

  <owl:Class rdf:about="https://snapkitty.example/scm#RootMorpheme">
    <rdfs:subClassOf rdf:resource="https://snapkitty.example/scm#Morpheme"/>
  </owl:Class>

  <!-- seed_unverified is not evidence -->
  <owl:Class rdf:about="https://snapkitty.example/scm#EvidenceSource">
    <rdfs:subClassOf rdf:resource="https://snapkitty.example/scm#Source"/>
    <owl:disjointWith rdf:resource="https://snapkitty.example/scm#UnverifiedSource"/>
  </owl:Class>
  <owl:Class rdf:about="https://snapkitty.example/scm#UnverifiedSource">
    <rdfs:subClassOf rdf:resource="https://snapkitty.example/scm#Source"/>
  </owl:Class>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://snapkitty.example/scm#Lexeme"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#OrthographicSlice"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#DerivationEdge"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#Morpheme"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#Sense"/>
      <rdf:Description rdf:about="https://snapkitty.example/scm#Source"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <!-- Rule: ancestor/2.
       derivedFrom is one recorded step and never loops back on itself.
       descendsFrom is the chain of steps, so it is transitive. -->
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#derivedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Lexeme"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Lexeme"/>
    <rdfs:subPropertyOf rdf:resource="https://snapkitty.example/scm#descendsFrom"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#descendsFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Lexeme"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Lexeme"/>
  </owl:ObjectProperty>

  <!-- Axiom: derived_from(Descendant, Ancestor, Source) is an edge with a source. -->
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#edgeDescendant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#DerivationEdge"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Lexeme"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#edgeAncestor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#DerivationEdge"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Lexeme"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#edgeSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#DerivationEdge"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Source"/>
  </owl:ObjectProperty>

  <owl:Class rdf:about="https://snapkitty.example/scm#DerivationEdge">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://snapkitty.example/scm#edgeDescendant"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://snapkitty.example/scm#Lexeme"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://snapkitty.example/scm#edgeAncestor"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://snapkitty.example/scm#Lexeme"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <!-- Evidence rule: exactly one source, and it is evidence. -->
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://snapkitty.example/scm#edgeSource"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://snapkitty.example/scm#EvidenceSource"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- Rule: shared_root/3.
       A word has morphemes, one kind of morpheme is a root, and two words
       that carry the same root share it. -->
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#hasMorpheme">
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Lexeme"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Morpheme"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#hasRoot">
    <rdfs:subPropertyOf rdf:resource="https://snapkitty.example/scm#hasMorpheme"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#RootMorpheme"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#sharesRootWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Lexeme"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Lexeme"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://snapkitty.example/scm#hasRoot"/>
      <rdf:Description>
        <owl:inverseOf rdf:resource="https://snapkitty.example/scm#hasRoot"/>
      </rdf:Description>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>

  <!-- Axiom: morpheme(Word, Position, Form, Kind, Source). -->
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#morphemeSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Morpheme"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Source"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://snapkitty.example/scm#position">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://snapkitty.example/scm#form">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:Class rdf:about="https://snapkitty.example/scm#Morpheme">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://snapkitty.example/scm#morphemeSource"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://snapkitty.example/scm#EvidenceSource"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- Axiom: sense(Word, SenseId, Gloss, Source). -->
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#hasSense">
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Lexeme"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Sense"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#senseSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Sense"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#Source"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://snapkitty.example/scm#gloss">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Sense"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:Class rdf:about="https://snapkitty.example/scm#Sense">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://snapkitty.example/scm#senseSource"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://snapkitty.example/scm#EvidenceSource"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- Axiom: lexeme(Word, Language, Form), etymology_text/3, orthographic_slice/3.
       A lexeme has one language and one form. Its slices are only letters:
       nothing here, or anywhere, derives an edge from spelling. -->
  <owl:DatatypeProperty rdf:about="https://snapkitty.example/scm#language">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Lexeme"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://snapkitty.example/scm#spelling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Lexeme"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://snapkitty.example/scm#hasSlice">
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#Lexeme"/>
    <rdfs:range rdf:resource="https://snapkitty.example/scm#OrthographicSlice"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://snapkitty.example/scm#letter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://snapkitty.example/scm#OrthographicSlice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:Class rdf:about="https://snapkitty.example/scm#Lexeme">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://snapkitty.example/scm#language"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- The one source that is not evidence -->
  <owl:NamedIndividual rdf:about="https://snapkitty.example/scm#seed_unverified">
    <rdf:type rdf:resource="https://snapkitty.example/scm#UnverifiedSource"/>
  </owl:NamedIndividual>
</rdf:RDF>
